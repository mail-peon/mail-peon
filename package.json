{
  "name": "mail-peon",
  "displayName": "Mail Peon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "AI mail assistant in your browser that surfaces the mail that matters and auto-copies verification codes",
  "scripts": {
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev-firefox": "pnpm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "pnpm run build:background -- --mode development",
    "dev:web": "vite",
    "dev:js": "pnpm run build:js -- --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:background build:js",
    "build:prepare": "esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.mts",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "node -e \"require('node:fs').rmSync('extension.zip', { force: true })\" && jszip-cli add extension/* -o ./extension.zip",
    "pack:crx": "crx3 extension -o ./extension.crx --keyPath key.pem",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "clear": "esno scripts/clean.ts",
    "icons": "esno scripts/icons.ts",
    "lint": "eslint --cache --no-warn-ignored .",
    "test": "vitest run",
    "relay": "esno scripts/imap-relay.ts",
    "relay:trace": "cross-env RELAY_TRACE=1 esno scripts/imap-relay.ts",
    "relay:kill": "esno scripts/relay-kill.ts",
    "relay:test": "esno scripts/imap-relay.test.ts",
    "relay:console-test": "esno scripts/relay-console.test.ts",
    "relay:port-test": "esno scripts/relay-port-prompt.test.ts",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "release": "bumpp"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "nanoid": "^6.0.2",
    "postal-mime": "^4.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@ffflorian/jszip-cli": "^3.16.8",
    "@iconify-json/pixelarticons": "^1.2.4",
    "@types/node": "^26.6.3",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "bumpp": "^12.3.0",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "eslint": "^10.11.0",
    "esno": "^4.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^16.0.0",
    "npm-run-all2": "^9.0.3",
    "sharp": "0.35.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-demi": "^0.14.10",
    "web-ext": "^10.7.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0",
    "ws": "^8.22.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": "eslint --fix"
  }
}
